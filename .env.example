DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=hasslab
POSTGRES_USER=hasslab
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379/0
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
AI_DEVICE=cpu

# Optional: shared trusted pretrained weights directory (default storage/base-weights).
# AI_BASE_WEIGHTS_DIR=/absolute/path/to/storage/base-weights
# Optional: shared lock file, same path for all AI workers on the host.
# AI_RESOURCE_LOCK=/absolute/path/to/storage/ai.lock
